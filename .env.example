# Byngox — environment config
# Copy to .env and edit before running

# NATS
NATS_URL=nats://localhost:4223

# Ollama inference
OLLAMA_URL=http://localhost:11434

# Model overrides
TIER1_MEDICAL_MODEL=meditron:7b
TIER2_MEDICAL_MODEL=meditron:70b
TIER2_REASONING_MODEL=deepseek-r1:70b
SECURITY_MODEL=phi4-mini

# Novela API
NOVELA_URL=http://localhost:8001
NOVELA_API_URL=http://localhost:8001
NOVELA_API_KEY=

NOVELA_SERVICE_TOKEN=

# CML
CML_TIMEOUT=5.0

# Agent tuning
AI_ASSESS_EVERY=10
TWIN_PUSH_INTERVAL_S=10
HEALTH_AGENT_TIMEOUT=120

# Logging
LOG_LEVEL=INFO
